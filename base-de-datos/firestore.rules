rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── AUTH HELPERS ─────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidatedDevice() {
      return isAnonymous() && request.auth.token.validatedDevice == true;
    }

    function userDocExists() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role
        : null;
    }

    function isRegisteredUser() {
      return userDocExists();
    }

    function isAdminLike() {
      return userRole() in ['ADMIN', 'SUPERADMIN'];
    }

    function isOperationalUser() {
      return userRole() in ['CARRETILLERO', 'ADMIN', 'SUPERADMIN'];
    }

    function isMonitoringUser() {
      return userRole() in ['JEFE_SECCION', 'CALIDAD', 'ADMIN', 'SUPERADMIN'];
    }

    function isChatParticipant() {
      return userRole() in ['ADMIN', 'SUPERADMIN', 'JEFE_SECCION', 'CARRETILLERO'];
    }

    function isSuperAdmin() {
      return userRole() == 'SUPERADMIN';
    }

    function userSection() {
      return userDocExists()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.section
        : null;
    }

    function canEditNotesAtLocation(shelfCode) {
      let role = userRole();
      // ADMIN/SUPERADMIN/CARRETILLERO en cualquier ubicación;
      // JEFE_SECCION solo con sección definida (validación fine-grained en frontend);
      // CALIDAD solo en CAL.
      return role in ['ADMIN', 'SUPERADMIN', 'CARRETILLERO']
          || (role == 'JEFE_SECCION' && userSection() != null)
          || (role == 'CALIDAD' && shelfCode == 'CAL');
    }

    // ── ACCESS POLICY HELPERS ─────────────────────────────────────────────────

    function canReadWarehouseState() {
      return isValidatedDevice() || isRegisteredUser() || isSuperAdmin();
    }

    function canReadHistory() {
      return isOperationalUser() || isMonitoringUser();
    }

    function canAccessAnyData() {
      return isSuperAdmin() || isAdminLike();
    }

    // Valida los campos opcionales de un documento de estado de conexión.
    // Previene inyección de campos arbitrarios en conexion_estado.
    function isValidConnectionStatusWrite() {
      let d = request.resource.data;
      return (!('deviceType' in d)  || d.deviceType in ['KIOSK', 'CARRETILLERO', 'ADMIN', 'UNKNOWN'])
          && (!('isOnline' in d)    || d.isOnline is bool)
          && (!('deviceId' in d)    || (d.deviceId is string   && d.deviceId.size() <= 200))
          && (!('deviceName' in d)  || (d.deviceName is string && d.deviceName.size() <= 200))
          && (!('zone' in d)        || (d.zone is string       && d.zone.size() <= 100))
          && (!('sessionId' in d)   || (d.sessionId is string  && d.sessionId.size() <= 100));
    }

    // ── USER SELF-UPDATE VALIDATION ───────────────────────────────────────────

    function validTokenList() {
      return !('fcmTokens' in request.resource.data)
          || (request.resource.data.fcmTokens is list
              && request.resource.data.fcmTokens.size() <= 20);
    }

    function validOptionalDisplayName() {
      return !('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() <= 120);
    }

    function validOptionalLastLoginAt() {
      return !('lastLoginAt' in request.resource.data)
          || (request.resource.data.lastLoginAt is string
              && request.resource.data.lastLoginAt.size() >= 20
              && request.resource.data.lastLoginAt.size() <= 35
              && request.resource.data.lastLoginAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*'));
    }

    function isSelfUserUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
                 .hasOnly(['fcmTokens', 'lastLoginAt', 'displayName'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.section == resource.data.section
          && request.resource.data.additionalSections == resource.data.additionalSections
          && validTokenList()
          && validOptionalDisplayName()
          && validOptionalLastLoginAt();
    }

    // ── COLLECTION RULES ─────────────────────────────────────────────────────

    match /usuarios/{userId} {
      allow get:    if isAdminLike() || (isRegisteredUser() && request.auth.uid == userId);
      allow list:   if isAdminLike();
      allow update: if isSuperAdmin() || (isRegisteredUser() && request.auth.uid == userId && isSelfUserUpdate());
      allow create, delete: if isSuperAdmin();
    }

    match /dispositivos/{deviceId} {
      // Los kioskos (dispositivos validados) necesitan leer su propia config para
      // obtener allowedShelves / excludedCarts / visualOnly (useDeviceConfig).
      // `list` sigue restringido a admins; `get` de un doc concreto es seguro.
      allow get:   if isAdminLike() || isValidatedDevice();
      allow list:  if isAdminLike();
      allow write: if false;
    }

    match /kiosks/{kioskId} {
      allow read:  if isAdminLike() || isValidatedDevice();
      allow write: if isSuperAdmin();
    }

    // ── ENGLISH COLLECTIONS (new system, matches backend + frontend) ─────

    match /shelves/{shelfCode} {
      allow read:  if canReadWarehouseState();
      allow write: if false;

      match /locations/{position} {
        allow read:  if canReadWarehouseState();
        // Permitir actualizar SOLO los campos "nota", "photos", "text" y/o "lastModified"
        // con restricciones de rol. Las fotos de ubicación (sección SOLDADURA) se escriben
        // desde el cliente igual que las notas; el binario vive en Storage, aquí solo el
        // array de metadatos. "text" y "lastModified" se usan en Útiles Soldadura (UTS).
        allow update: if isRegisteredUser()
                         && canEditNotesAtLocation(shelfCode)
                         && request.resource.data.diff(resource.data).changedKeys().hasOnly(['nota', 'photos', 'text', 'lastModified']);
        // Permitir crear el doc de una ubicación VACÍA solo para adjuntarle nota, fotos
        // y/o datos de texto libre (UTS). Forma acotada: sin items, mismos roles que notas.
        allow create: if isRegisteredUser()
                         && canEditNotesAtLocation(shelfCode)
                         && request.resource.data.keys().hasOnly(['position', 'items', 'isEmpty', 'nota', 'photos', 'text', 'lastModified'])
                         && request.resource.data.items.size() == 0;
        allow delete: if false;
      }
    }

    match /chapero_positions/{positionId} {
      allow read:  if canReadWarehouseState() || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /items/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /itemAggregates/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /history/{document=**} {
      allow read:  if canReadHistory();
      allow write: if false;
    }

    match /config/{document=**} {
      // Los kioskos (dispositivos validados) precachean config/app al arrancar
      // (useInitializeCriticalData). canReadWarehouseState() incluye dispositivos
      // validados y usuarios registrados, evitando el error "permisos insuficientes".
      allow read:  if canReadWarehouseState() || isOperationalUser();
      allow write: if isSuperAdmin();
    }

    match /pickupQueue/{document=**} {
      allow read:  if isValidatedDevice() || isOperationalUser();
      allow write: if false;
    }

    // ── ERP: autorrelleno de artículo por OF ─────────────────────────────────
    // Canal de petición/respuesta con el bridge local (ver bridge/README.md).
    // La app SOLO puede encargar una consulta ({status:'pending'}); los
    // resultados los escribe el bridge con el Admin SDK, que no pasa por reglas.
    match /erp_lookups/{ofId} {
      allow read: if canReadWarehouseState();

      // Encargar una consulta nueva. Se acotan las claves para que nadie pueda
      // inyectar un `articles` falso y envenenar la caché que ven los demás.
      allow create: if canReadWarehouseState()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.of == ofId
                    && request.resource.data.keys().hasOnly(['of', 'status', 'requestedAt', 'requestedBy'])
                    && (!('requestedBy' in request.resource.data)
                        || request.resource.data.requestedBy == null
                        || request.resource.data.requestedBy == request.auth.uid);

      // Repetir la consulta de una OF ya cacheada: mismas restricciones.
      allow update: if canReadWarehouseState()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.of == ofId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['of', 'status', 'requestedAt', 'requestedBy'])
                    && (!('requestedBy' in request.resource.data)
                        || request.resource.data.requestedBy == null
                        || request.resource.data.requestedBy == request.auth.uid);

      allow delete: if false;
    }

    // Latido del bridge: solo para diagnóstico desde el panel de admin.
    match /erp_bridge/{document=**} {
      allow read:  if isAdminLike();
      allow write: if false;
    }

    // ── CONNECTION MONITORING ────────────────────────────────────────────────
    // Cada dispositivo escribe su propio doc (keyed por auth.uid).
    // Solo ADMIN/SUPERADMIN pueden leer la coleccion completa.

    match /conexion_estado/{uid} {
      allow read: if isAdminLike();
      allow write: if isAuthenticated()
                   && request.auth.uid == uid
                   && request.resource.data.authUid == request.auth.uid
                   && isValidConnectionStatusWrite();
    }

    match /conexion_logs/{logId} {
      allow read: if isAdminLike();
      allow create: if isAuthenticated()
                    && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.timestamp is string
                    && request.resource.data.timestamp.size() >= 20
                    && request.resource.data.timestamp.size() <= 35
                    && request.resource.data.event is string
                    && request.resource.data.event in ['CONNECTED', 'DISCONNECTED', 'HEARTBEAT']
                    && (!('deviceName' in request.resource.data) || request.resource.data.deviceName is string)
                    && (!('zone' in request.resource.data) || (request.resource.data.zone is string && request.resource.data.zone.size() <= 100))
                    && (!('deviceType' in request.resource.data) || request.resource.data.deviceType in ['KIOSK', 'CARRETILLERO', 'ADMIN', 'UNKNOWN']);
      allow update, delete: if false;
    }

    // Snapshots de calidad de red (useNetworkQuality / WifiQualityTab). Igual
    // patron que conexion_logs: cada dispositivo solo crea sus propios registros
    // (authUid = auth.uid), inmutables; solo admins pueden leer la coleccion.
    // NOTA: sin esta regla la coleccion queda denegada por defecto y la funcion
    // de monitor de calidad WiFi falla en silencio (permission-denied).
    match /conexion_quality/{docId} {
      allow read: if isAdminLike();
      allow create: if isAuthenticated()
                    && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.deviceId is string
                    && request.resource.data.deviceId.size() <= 200
                    && request.resource.data.deviceName is string
                    && request.resource.data.deviceName.size() <= 200
                    && request.resource.data.deviceType in ['KIOSK', 'CARRETILLERO', 'ADMIN', 'UNKNOWN']
                    && request.resource.data.timestamp is string
                    && request.resource.data.timestamp.size() >= 20
                    && request.resource.data.timestamp.size() <= 35
                    && request.resource.data.qualityScore is number
                    && request.resource.data.qualityLabel is string
                    && (!('zone' in request.resource.data) || (request.resource.data.zone is string && request.resource.data.zone.size() <= 100));
      allow update, delete: if false;
    }

    // ── PRODUCCIÓN: workingItems / finishedItems / assignments ───────────────
    // Gestionadas por Cloud Function `productionOperate`. El código legacy del
    // frontend las leerá en tiempo real; las escrituras quedan bloqueadas para
    // forzar el uso de Cloud Functions y mantener la consistencia transaccional.

    match /workingItems/{document=**} {
      allow read:  if isAdminLike() || userRole() in ['JEFE_SECCION', 'CALIDAD'];
      allow write: if false;  // solo vía Cloud Function productionOperate
    }

    match /finishedItems/{document=**} {
      allow read:  if isAdminLike() || userRole() in ['JEFE_SECCION', 'CALIDAD'];
      allow write: if false;  // solo vía Cloud Function productionOperate
    }

    match /assignments/{document=**} {
      allow read:  if isAdminLike() || userRole() in ['JEFE_SECCION', 'CALIDAD'];
      allow write: if false;  // solo vía Cloud Function productionOperate
    }

    // ── LEGACY: carts / supplies_soldadura / supplies_carts ───────────────────
    // Lectura permitida para compatibilidad; escritura bloqueada (solo Cloud Functions).

    match /carts/{document=**} {
      allow read:  if isRegisteredUser();
      allow write: if false;
    }

    match /supplies_soldadura/{document=**} {
      allow read:  if isAdminLike() || userRole() == 'JEFE_SECCION';
      allow write: if false;
    }

    match /supplies_carts/{document=**} {
      allow read:  if isAdminLike() || userRole() == 'JEFE_SECCION';
      allow write: if false;
    }

    // ── NOTIFICACIONES (legacy) ──────────────────────────────────────────────
    // Usadas por vistas legacy del sistema anterior. En v3 las notificaciones
    // van por FCM/push. Escritura bloqueada; solo Cloud Functions pueden escribir.

    match /notifications/{document=**} {
      allow read:  if isRegisteredUser() || isValidatedDevice();
      allow write: if false;
    }

    // ── AVISOS PERSISTENTES (fallback modal rojo) ────────────────────────────
    // Creados por Cloud Function (notifySpecialLocationOccupancy) para los avisos
    // URGENTES a jefes de sección. El destinatario puede leer los suyos y marcarlos
    // como reconocidos (acknowledged). Creación/borrado solo vía backend (admin SDK).
    match /pendingAlerts/{alertId} {
      allow read:   if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow update: if request.auth != null
                       && resource.data.recipientUid == request.auth.uid
                       && request.resource.data.recipientUid == resource.data.recipientUid
                       && request.resource.data.diff(resource.data).changedKeys().hasOnly(['acknowledged', 'acknowledgedAt']);
      allow create, delete: if false;
    }

    // ── LOGS Y AUDITORÍA ADMIN ───────────────────────────────────────────────
    // Escritura exclusiva de Cloud Functions. Lectura restringida a admins.

    match /adminMessages/{document=**} {
      allow read:  if isAdminLike();
      allow write: if false;
    }

    match /notificationHistory/{document=**} {
      allow read:  if isAdminLike();
      allow write: if false;
    }

    match /inboundOrders/{document=**} {
      allow read:  if isAdminLike();
      allow write: if false;
    }

    // ── COLECCIONES INTERNAS DE BACKEND ─────────────────────────────────────
    // `_ops`: solo generación de IDs en Cloud Functions. Nunca accesible desde cliente.

    match /_ops/{document=**} {
      allow read, write: if false;
    }

    // ── CONVERSACIONES PRIVADAS ──────────────────────────────────────────────
    // Creadas por ADMIN/SUPERADMIN vía Cloud Function. Solo miembros acceden.

    // Verifica que el usuario autenticado sea miembro de la sala (1 lectura extra por operación).
    function isMemberOfConversation(convId) {
      return isAuthenticated()
          && isRegisteredUser()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.memberUids;
    }

    // Valida la estructura completa de un nuevo mensaje en una sala privada.
    // Previene inyección de campos espurios y fuerza la integridad del readBy inicial.
    function isValidConvMessage() {
      let d = request.resource.data;
      return d.senderId == request.auth.uid
          && d.text is string
          && d.text.size() >= 1
          && d.text.size() <= 2000
          && d.senderName is string
          && d.senderName.size() >= 1
          && d.senderRole is string
          && d.senderRole in ['ADMIN', 'SUPERADMIN', 'JEFE_SECCION', 'CARRETILLERO', 'CALIDAD', 'OPERARIO', 'SOLO_VISUAL']
          && d.readBy is list
          && d.readBy.size() == 1
          && d.readBy[0] == request.auth.uid;
    }

    // Valida la estructura de un mensaje en el chat interno (general).
    // Igual que isValidConvMessage pero para el canal público/general.
    function isValidChatMessage() {
      let d = request.resource.data;
      return d.senderId == request.auth.uid
          && d.text is string
          && d.text.size() >= 1
          && d.text.size() <= 2000
          && d.senderName is string
          && d.senderName.size() >= 1
          && d.senderName.size() <= 120
          && d.senderRole is string
          && d.senderRole in ['ADMIN', 'SUPERADMIN', 'JEFE_SECCION', 'CARRETILLERO', 'CALIDAD', 'OPERARIO', 'SOLO_VISUAL']
          && d.readBy is list
          && d.readBy.size() == 1
          && d.readBy[0] == request.auth.uid;
    }

    // Garantiza que el único cambio posible sea añadir el uid propio a readBy.
    // Reutilizada en chat/general y conversations (evita duplicación).
    function onlyReadByAppend() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.readBy)
          && request.resource.data.readBy.hasOnly(resource.data.readBy.concat([request.auth.uid]));
    }

    match /conversations/{convId} {
      // isRegisteredUser() garantiza email-auth; previene acceso de sesiones anónimas/kiosk.
      allow get:  if isRegisteredUser() && (isAdminLike() || resource.data.memberUids.hasAny([request.auth.uid]));
      allow list: if isRegisteredUser() && (isAdminLike() || resource.data.memberUids.hasAny([request.auth.uid]));
      allow write: if false;  // solo vía Cloud Functions (chatCreateConversation)

      match /messages/{msgId} {
        allow read:   if isAdminLike() || isMemberOfConversation(convId);
        allow create: if isMemberOfConversation(convId) && isValidConvMessage();
        allow update: if isMemberOfConversation(convId) && onlyReadByAppend();
        allow delete: if false;
      }
    }

    // ── ALERTAS DE URGENCIA INDEPENDIENTES ───────────────────────────────────
    // Creadas y resueltas exclusivamente por Cloud Functions (ADMIN/SUPERADMIN).
    // Lectura: todos los usuarios registrados y dispositivos validados.

    match /urgent_alerts/{alertId} {
      allow read:  if isRegisteredUser() || isValidatedDevice();
      allow write: if false;  // solo vía Cloud Functions
    }

    // ── CHAT INTERNO ─────────────────────────────────────────────────────────
    // Acceso para ADMIN, SUPERADMIN, JEFE_SECCION y CARRETILLERO (OPERARIO/CALIDAD fuera).
    // Los mensajes se crean vía Cloud Function `chatSendMessage`; las reglas permiten
    // además crear con senderId propio y actualizar EXCLUSIVAMENTE el propio readBy.

    match /chat/{roomId} {
      allow read:  if isChatParticipant();
      allow write: if false; // la sala la gestiona el backend

      match /messages/{messageId} {
        allow read:   if isChatParticipant();
        allow create: if isChatParticipant() && isValidChatMessage();
        allow update: if isChatParticipant() && onlyReadByAppend();
        allow delete: if false; // limpieza vía Cloud Function
      }

      match /pinned/{pinnedId} {
        // Lectura: todos los participantes del chat pueden ver los avisos fijados
        allow read:   if isChatParticipant();
        // Escritura/eliminación: solo vía Cloud Functions (setPinnedUrgency / removePinnedUrgency)
        allow create, update, delete: if false;
      }
    }

    // ── DEVELOPMENT MODE: Allow all access ──────────────────────────────────
    // match /{document=**} {
    //   allow read, write: if true;
    // }
  }
}
