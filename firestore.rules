rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── AUTH HELPERS ─────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated()
          && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isValidatedDevice() {
      return isAnonymous() && request.auth.token.validatedDevice == true;
    }

    function userDocExists() {
      return isAuthenticated()
          && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role
        : null;
    }

    function isRegisteredUser() {
      return userDocExists();
    }

    function isAdminLike() {
      return userRole() in ['ADMIN', 'SUPERADMIN'];
    }

    function isOperationalUser() {
      return userRole() in ['CARRETILLERO', 'ADMIN', 'SUPERADMIN'];
    }

    function isMonitoringUser() {
      return userRole() in ['JEFE_SECCION', 'CALIDAD', 'ADMIN', 'SUPERADMIN'];
    }

    function isSuperAdmin() {
      return userRole() == 'SUPERADMIN';
    }

    // ── ACCESS POLICY HELPERS ─────────────────────────────────────────────────

    function canReadWarehouseState() {
      return isValidatedDevice() || isRegisteredUser();
    }

    function canReadHistory() {
      return isOperationalUser() || isMonitoringUser();
    }

    // ── USER SELF-UPDATE VALIDATION ───────────────────────────────────────────

    function validTokenList() {
      return !('fcmTokens' in request.resource.data)
          || (request.resource.data.fcmTokens is list
              && request.resource.data.fcmTokens.size() <= 20);
    }

    function validOptionalDisplayName() {
      return !('displayName' in request.resource.data)
          || (request.resource.data.displayName is string
              && request.resource.data.displayName.size() <= 120);
    }

    function validOptionalLastLoginAt() {
      return !('lastLoginAt' in request.resource.data)
          || (request.resource.data.lastLoginAt is string
              && request.resource.data.lastLoginAt.size() >= 20
              && request.resource.data.lastLoginAt.size() <= 35
              && request.resource.data.lastLoginAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*'));
    }

    function isSelfUserUpdate() {
      return request.resource.data.diff(resource.data).changedKeys()
                 .hasOnly(['fcmTokens', 'lastLoginAt', 'displayName'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.section == resource.data.section
          && request.resource.data.additionalSections == resource.data.additionalSections
          && validTokenList()
          && validOptionalDisplayName()
          && validOptionalLastLoginAt();
    }

    // ── COLLECTION RULES ─────────────────────────────────────────────────────

    match /configuracion/{document=**} {
      allow read: if canReadWarehouseState();
      allow write: if isSuperAdmin();
    }

    match /usuarios/{userId} {
      allow get:    if isAdminLike() || (isRegisteredUser() && request.auth.uid == userId);
      allow list:   if isAdminLike();
      allow update: if isSuperAdmin() || (isRegisteredUser() && request.auth.uid == userId && isSelfUserUpdate());
      allow create, delete: if isSuperAdmin();
    }

    match /dispositivos/{deviceId} {
      allow get, list: if isSuperAdmin();
      allow write:     if false;
    }

    match /tablets/{tabletId} {
      allow read:  if canReadWarehouseState();
      allow write: if isSuperAdmin();
    }

    match /estanterias/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /ubicaciones/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /piezas/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /resumen_piezas/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /piezas_agregadas/{document=**} {
      allow read:  if canReadWarehouseState();
      allow write: if false;
    }

    match /cola_recogida/{document=**} {
      allow read:  if isValidatedDevice() || isOperationalUser();
      allow write: if false;
    }

    match /historial/{document=**} {
      allow read:  if canReadHistory();
      allow write: if false;
    }

    match /avisos/{document=**} {
      allow read:  if isOperationalUser() || isMonitoringUser();
      allow write: if false;
    }

    match /chat_mensajes/{document=**} {
      allow read:  if isRegisteredUser();
      allow write: if false;
    }

    match /piezas_en_curso/{document=**} {
      allow read:  if isMonitoringUser();
      allow write: if false;
    }

    match /piezas_terminadas/{document=**} {
      allow read:  if isMonitoringUser();
      allow write: if false;
    }

    // ── CONNECTION MONITORING ────────────────────────────────────────────────
    // Cada dispositivo escribe su propio doc (keyed por auth.uid).
    // Solo ADMIN/SUPERADMIN pueden leer la coleccion completa.

    match /conexion_estado/{uid} {
      allow read: if isAdminLike();
      allow write: if isAuthenticated()
                   && request.auth.uid == uid
                   && request.resource.data.authUid == request.auth.uid;
    }

    match /conexion_logs/{logId} {
      allow read: if isAdminLike();
      allow create: if isAuthenticated()
                    && request.resource.data.authUid == request.auth.uid
                    && request.resource.data.timestamp is string;
      allow update, delete: if false;
    }

    // Legacy fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
