rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnonymous() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isRegisteredUser() {
      return userDocExists();
    }

    function isAdminLike() {
      return userRole() in ['ADMIN', 'SUPERADMIN'];
    }

    function isOperationalUser() {
      return userRole() in ['CARRETILLERO', 'ADMIN', 'SUPERADMIN'];
    }

    function isMonitoringUser() {
      return userRole() in ['JEFE_SECCION', 'CALIDAD', 'ADMIN', 'SUPERADMIN'];
    }

    function isSuperAdmin() {
      return userRole() == 'SUPERADMIN';
    }

    function canReadWarehouseState() {
      return isAnonymous() || isRegisteredUser();
    }

    function canWriteWarehouseState() {
      return false;
    }

    function canReadPickupQueue() {
      return isAnonymous() || isOperationalUser();
    }

    function canWritePickupQueue() {
      return false;
    }

    function canReadHistory() {
      return isOperationalUser() || isMonitoringUser();
    }

    function canWriteHistory() {
      return false;
    }

    function isSelf(userId) {
      return isRegisteredUser() && request.auth.uid == userId;
    }

    function validTokenList() {
      return !('fcmTokens' in request.resource.data)
        || (request.resource.data.fcmTokens is list
          && request.resource.data.fcmTokens.size() <= 20);
    }

    function validOptionalDisplayName() {
      return !('displayName' in request.resource.data)
        || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 120);
    }

    function validOptionalLastLoginAt() {
      return !('lastLoginAt' in request.resource.data)
        || request.resource.data.lastLoginAt is string;
    }

    function isSelfUserUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['fcmTokens', 'lastLoginAt', 'displayName'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.section == resource.data.section
        && request.resource.data.additionalSections == resource.data.additionalSections
        && validTokenList()
        && validOptionalDisplayName()
        && validOptionalLastLoginAt();
    }

    match /config/{document=**} {
      allow read: if isMonitoringUser();
      allow write: if isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isAdminLike() || (isRegisteredUser() && request.auth.uid == userId);
      allow list: if isAdminLike();
      allow update: if isSuperAdmin() || (isSelf(userId) && isSelfUserUpdate());
      allow create, delete: if isSuperAdmin();
    }

    match /devices/{deviceId} {
      allow get, list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    match /shelves/{document=**} {
      allow read: if canReadWarehouseState();
      allow write: if canWriteWarehouseState();
    }

    match /items/{document=**} {
      allow read: if canReadWarehouseState();
      allow write: if canWriteWarehouseState();
    }

    match /itemAggregates/{document=**} {
      allow read: if canReadWarehouseState();
      allow write: if canWriteWarehouseState();
    }

    match /pickupQueue/{document=**} {
      allow read: if canReadPickupQueue();
      allow write: if canWritePickupQueue();
    }

    match /history/{document=**} {
      allow read: if canReadHistory();
      allow write: if canWriteHistory();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
