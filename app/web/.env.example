# ═══════════════════════════════════════════
# Gestor de Estanterías WMS v3.0
# Variables de entorno
# ═══════════════════════════════════════════

# ── Firebase (NUEVO PROYECTO — Rellenar con datos del proyecto nuevo) ──
VITE_FIREBASE_API_KEY=TU_API_KEY_AQUI
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto-id
VITE_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

# ── Firebase Cloud Messaging (Push Notifications) ──
VITE_FIREBASE_VAPID_KEY=TU_VAPID_KEY_AQUI

# ── API Swagger - Servidor Interno (Operarios) ──
VITE_SWAGGER_BASE_URL=http://10.0.0.19:8000

# ── Emuladores Firebase (solo desarrollo) ──
# VITE_USE_EMULATORS=true
