# API de OpenAI
OPENAI_API_KEY=sk-...

# OpenWA (clonar y ejecutar desde https://github.com/rmyndharis/OpenWA)
OPENWA_URL=http://localhost:2785
OPENWA_API_KEY=tu-api-key-del-dashboard-openwa
OPENWA_SESSION_ID=favram-bot

# Tu número de WhatsApp (prefijo de pais + número, sin + ni espacios)
# Ejemplo España: 34612345678
AUTHORIZED_PHONE=34XXXXXXXXX

# Puerto donde escucha el bot
WEBHOOK_PORT=3001

# Ruta al serviceAccount del proyecto Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=../serviceAccount.json
