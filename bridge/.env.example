# ─── Configuración del ERP Bridge ───────────────────────────────────────────
# Copia este fichero a `.env` y ajusta los valores.
# El `.env` real y la clave JSON NUNCA se suben a git (ver .gitignore).

# Clave de la service account de Firebase con la que el bridge escribe en
# Firestore. Usa una service account DEDICADA al bridge, no la del proyecto.
GOOGLE_APPLICATION_CREDENTIALS=C:\erp-bridge\bridge-service-account.json

# ID del proyecto de Firebase (opcional: se deduce de la clave JSON).
# FIREBASE_PROJECT_ID=

# API del ERP dentro de la LAN.
ERP_BASE_URL=http://10.0.0.19:8000

# Cuánto esperamos al ERP antes de dar la consulta por fallida (ms).
ERP_TIMEOUT_MS=15000

# Días que se conservan las consultas ya resueltas antes de borrarlas.
RETENTION_DAYS=30
