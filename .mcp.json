{
  "mcpServers": {
    "firebase": {
      "command": "npx",
      "args": [
        "-y",
        "firebase-tools",
        "mcp"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": ""
      }
    },
    "ruflo": {
      "command": "npx",
      "args": [
        "ruflo@latest",
        "mcp",
        "start"
      ]
    }
  }
}
